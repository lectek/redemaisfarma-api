<form id="loginForm" action="/login" method="post" class="form-grid" autocomplete="on" novalidate><input type="hidden" name="_csrf" value="Q6o6IDYqAlnCY1xZR7RYnfgaTkN-wP6KgP6a_HENVI20GUWUdJ8KF1IbYWDvWmxocJlsqMF8Y3tOppin4suuz0k1Nb3XIHCi"/>
  <input type="hidden" name="_csrf" value="Q6o6IDYqAlnCY1xZR7RYnfgaTkN-wP6KgP6a_HENVI20GUWUdJ8KF1IbYWDvWmxocJlsqMF8Y3tOppin4suuz0k1Nb3XIHCi"/>

  <!-- Seletor de perfil define o destino pós-login -->
  <div class="form-row gap-3 mb-3" role="group" aria-label="Tipo de acesso">
    <label class="chip">
      <input type="radio" name="perfil" value="cliente" checked>
      <span>Cliente</span>
    </label>
    <label class="chip">
      <input type="radio" name="perfil" value="admin">
      <span>Admin</span>
    </label>
  </div>
  <input type="hidden" name="redirect" id="redirect" value="/cliente/conta"/>

  <!-- Campos padrão do Spring Security -->
  <div class="form-group">
    <label for="usuario">E-mail / CPF / Usuário</label>
    <input id="usuario" class="input" type="text" name="username" autocomplete="username"
           placeholder="ex.: joao@dominio.com" required autofocus/>
  </div>

  <div class="form-group">
    <label for="senha">Senha</label>
    <div class="input-with-action">
      <input id="senha" class="input" type="password" name="password"
             autocomplete="current-password" required minlength="8" maxlength="128"/>
      <button type="button" class="btn btn--ghost btn--icon" id="toggleSenha"
              aria-pressed="false" aria-label="Mostrar senha">👁</button>
    </div>
    <small class="help">Use 8+ caracteres, com maiúscula, minúscula, número e símbolo.</small>
  </div>

  <label class="remember">
    <input id="lembrarMe" type="checkbox" name="remember-me"/>
    <span>Lembrar de mim (sessão maior)</span>
  </label>

  <div class="form-actions" style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center">
    <button id="entrarBtn" type="submit" class="btn btn--primary">Entrar</button>
    <a href="/auth/esqueci-senha" class="btn btn--ghost" role="button">Esqueci minha senha</a>
  </div>

  <nav class="links mt-12" aria-label="Acesso rápido">
    <a href="/auth/esqueci-senha">Esqueci a senha</a>
    &nbsp;•&nbsp;
    <a href="/auth/mudar-senha">Mudar minha senha</a>
    &nbsp;•&nbsp;
    <a href="/auth/cliente/cadastro">Criar conta de cliente</a>
  </nav>
</form>

<script>
  // trocar destino pós-login conforme perfil
  const redirect = document.getElementById('redirect');
  document.querySelectorAll('input[name="perfil"]').forEach(r => {
    r.addEventListener('change', () => {
      redirect.value = r.value === 'admin' ? '/admin/conta' : '/cliente/conta';
    });
  });
  // mostrar/ocultar senha
  document.getElementById('toggleSenha')?.addEventListener('click', () => {
    const f = document.getElementById('senha');
    const on = f.type === 'password';
    f.type = on ? 'text' : 'password';
  });
</script>

